#!/usr/bin/env python3
"""validate-core: integrity validator for the agentic plugin and for a project's harness files.

  validate-core                           validate the plugin this script belongs to
  validate-core --project DIR             validate DIR/.agents/harnesses/*.json (harness JSON v2)
  validate-core --project DIR --harness-file PATH  validate a single host or coordinator harness JSON v2 file

Read-only and offline: stdlib only, writes nothing. Exit 0 with no problems, 1 with problems
(`rule: message` lines on stdout), 2 on bad usage.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import re
import subprocess
import sys
from collections import Counter
from pathlib import Path

PLUGIN_ROOT = Path(__file__).resolve().parent.parent
# A hook prints a whole file into every session; Claude Code keeps only a preview of output
# above ~10 KiB, so the budget keeps margin.
HOOK_PRINT_BUDGET = 8704
ASSET_DIRS = ("skills", "methodology", "roles", "agents", "templates")
CLASSES = {"copy", "link-rewrite", "path-reword", "deliberate-delta"}
MANIFESTS = (".codex-plugin/plugin.json", ".claude-plugin/plugin.json", ".antigravity-plugin/plugin.json")
MARKETPLACES = (".claude-plugin/marketplace.json", ".agents/plugins/marketplace.json")
SHIMS = {
    "agentic-relay": "agent-relay",
    "agentic-check-delegation-route": "check-delegation-route",
    "agentic-usage-report": "report-agent-usage",
    "agentic-usage-auto": "auto-agent-usage",
    "agentic-verify-project": "verify-project.py",
}
CATALOGUE_DOCS = ("methodology/issue-workflow.md", "skills/work-issue/SKILL.md", "templates/issue.md")

# --- Harness JSON v2 (ported from the template validator `check_harness`) -------------------
CANONICAL_ROLES = ("functional", "implementation", "qa-review", "infrastructure")
HOST_ROLES = CANONICAL_ROLES + ("review",)
HOST_FILENAMES = ("t3.json", "t3.local.json")
PROVIDER_PATTERN = re.compile(r"^[A-Za-z][A-Za-z0-9_-]*$")
EXTERNAL_TASKS = ("review", "investigate", "develop")
EXTERNAL_MODES = ("automatic", "on_request", "disabled")
EXTERNAL_TRANSPORTS = ("cli",)
HARNESS_NAMES = ("claude", "codex", "opencode", "hermes", "antigravity")


def unique_json_object(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError(f"duplicate key: {key}")
        result[key] = value
    return result


def reject_json_constant(value):
    raise ValueError(f"invalid JSON constant: {value}")


def load_json(path):
    """Strict JSON: unique keys, no NaN/Infinity."""
    return json.loads(Path(path).read_text(encoding="utf-8"), object_pairs_hook=unique_json_object,
                      parse_constant=reject_json_constant)


def _fields(value, allowed, location, problems):
    if not isinstance(value, dict):
        problems.append(f"{location}: must be an object")
        return False
    for key in sorted(value.keys() - set(allowed)):
        problems.append(f"{location}: unknown field {key}")
    return True


def _selection(value, location, problems):
    for key in ("model", "effort"):
        setting = value.get(key)
        if setting is not None and not (isinstance(setting, str) and setting.strip()):
            problems.append(f"{location}.{key}: must be null or a non-empty string")


def _host_selection(value, location, problems, *, required):
    _selection(value, location, problems)
    provider = value.get("provider")
    if provider is not None and not (isinstance(provider, str) and PROVIDER_PATTERN.fullmatch(provider)):
        problems.append(f"{location}.provider: must match {PROVIDER_PATTERN.pattern}")
    model = value.get("model")
    effort = value.get("effort")
    if required:
        if provider is None or model is None:
            problems.append(f"{location}: provider and model are required")
    elif (provider is not None or model is not None or effort is not None) and (provider is None or model is None):
        problems.append(f"{location}: provider and model are required when setting defaults")


def check_harness(config, coordinator):
    problems = []
    if not _fields(config, ("version", "local", "external"), "config", problems):
        return problems
    if type(config.get("version")) is not int or config["version"] != 2:
        problems.append("version must be integer 2")
    local = config.get("local", {})
    if _fields(local, ("model", "effort", "profiles"), "local", problems):
        _selection(local, "local", problems)
        profiles = local.get("profiles", {})
        if _fields(profiles, CANONICAL_ROLES, "local.profiles", problems):
            for role in CANONICAL_ROLES:
                if role not in profiles:
                    continue
                levels = profiles[role]
                location = f"local.profiles.{role}"
                if not _fields(levels, ("standard", "complex"), location, problems):
                    continue
                for name in ("standard", "complex"):
                    if name not in levels:
                        continue
                    profile = levels[name]
                    level = f"{location}.{name}"
                    if _fields(profile, ("model", "effort"), level, problems):
                        _selection(profile, level, problems)
                        if all(profile.get(key) is None for key in ("model", "effort")):
                            problems.append(f"{level}: must set model or effort")

    external = config.get("external", {})
    if not isinstance(external, dict):
        return problems + ["external: must be an object"]
    for client, entry in external.items():
        location = f"external.{client}"
        if not re.fullmatch(r"[a-z][a-z0-9]*(?:-[a-z0-9]+)*", client):
            problems.append(f"{location}: invalid client name")
        if not _fields(entry, ("enabled", "transport", "model", "effort", "tasks"), location, problems):
            continue
        if not isinstance(entry.get("enabled"), bool):
            problems.append(f"{location}.enabled: must be boolean")
        if entry.get("transport") not in EXTERNAL_TRANSPORTS:
            problems.append(f"{location}.transport: must be cli")
        _selection(entry, location, problems)
        tasks = entry.get("tasks")
        if not _fields(tasks, EXTERNAL_TASKS, f"{location}.tasks", problems):
            continue
        for task, mode in tasks.items():
            if mode not in EXTERNAL_MODES:
                problems.append(f"{location}.{task}: invalid mode")
            elif mode == "automatic" and (coordinator, client, task) != ("claude", "codex", "review"):
                problems.append(f"{location}.{task}: automatic is only for Claude Code to Codex review")
    return problems


def check_host_config(config):
    """Validate a host worker configuration (t3.json / t3.local.json)."""
    problems = []
    if not _fields(config, ("version", "local"), "config", problems):
        return problems
    if type(config.get("version")) is not int or config["version"] != 2:
        problems.append("version must be integer 2")
    local = config.get("local", {})
    if _fields(local, ("provider", "model", "effort", "profiles"), "local", problems):
        _host_selection(local, "local", problems, required=False)
        profiles = local.get("profiles", {})
        if _fields(profiles, HOST_ROLES, "local.profiles", problems):
            for role, entry in profiles.items():
                location = f"local.profiles.{role}"
                if not isinstance(entry, dict):
                    problems.append(f"{location}: must be an object")
                    continue
                if role != "review" and any(key in entry for key in ("standard", "complex")):
                    if not _fields(entry, ("standard", "complex"), location, problems):
                        continue
                    for name in ("standard", "complex"):
                        if name not in entry:
                            continue
                        profile = entry[name]
                        level = f"{location}.{name}"
                        if _fields(profile, ("provider", "model", "effort"), level, problems):
                            _host_selection(profile, level, problems, required=True)
                elif _fields(entry, ("provider", "model", "effort"), location, problems):
                    _host_selection(entry, location, problems, required=True)
    return problems


def check_harness_file(path, project):
    """Problems (`harness-config: ...`) for a single host or coordinator harness file."""
    project = Path(project).resolve()
    path = Path(path)
    errors = []

    def fail(message):
        errors.append(f"harness-config: {message}")

    is_host = path.name in HOST_FILENAMES
    is_coordinator = path.suffix == ".json" and path.stem in HARNESS_NAMES
    if not (is_host or is_coordinator):
        fail(f"invalid coordinator filename: {path.name}")
        return errors
    if not path.is_file() or not path.resolve().is_relative_to(project):
        fail(f"invalid {'host' if is_host else 'coordinator'} file: {path.name}")
        return errors
    try:
        config = load_json(path)
    except (OSError, ValueError) as error:
        fail(f"{path.name}: {error}")
        return errors
    problems = check_host_config(config) if is_host else check_harness(config, path.stem)
    for problem in problems:
        fail(f"{path.name}: {problem}")
    return errors


def check_project_harnesses(project):
    """Problems (`harness-config: ...`) for <project>/.agents/harnesses/*.json."""
    project = Path(project).resolve()
    errors = []

    def fail(message):
        errors.append(f"harness-config: {message}")

    legacy = project / ".agents/external-agents.json"
    if legacy.exists() or legacy.is_symlink():
        fail("remove obsolete .agents/external-agents.json")
    directory = project / ".agents/harnesses"
    if not directory.resolve().is_relative_to(project):
        fail("harness directory must stay inside the project")
    elif directory.is_dir():
        for path in sorted(directory.iterdir()):
            errors.extend(check_harness_file(path, project))
    return errors


def harness_report(project):
    directory = Path(project).resolve() / ".agents/harnesses"
    names = sorted(path.name for path in directory.glob("*.json")) if directory.is_dir() else []
    return f"harness files checked: {', '.join(names) if names else 'none'}"


# --- Plugin integrity ---------------------------------------------------------------------
def prose_lines(text):
    """Lines outside fenced code, with inline code spans blanked."""
    fenced = False
    for number, line in enumerate(text.split("\n"), 1):
        if re.match(r"^\s*(```|~~~)", line):
            fenced = not fenced
            continue
        if not fenced:
            yield number, re.sub(r"`[^`]*`", "", line)


def slugs(path):
    seen = Counter()
    result = set()
    for _, line in prose_lines(Path(path).read_text(encoding="utf-8")):
        match = re.match(r"^#{1,6}\s+(.*?)\s*#*\s*$", line)
        if not match:
            continue
        raw = re.sub(r"\[([^\]]*)\]\([^)]*\)", r"\1", match.group(1))
        slug = re.sub(r"[^\w\- ]", "", raw.lower()).replace(" ", "-")
        result.add(slug if not seen[slug] else f"{slug}-{seen[slug]}")
        seen[slug] += 1
    return result


def frontmatter(path):
    match = re.match(r"^---\n(.*?)\n---\n", Path(path).read_text(encoding="utf-8"), re.S)
    if not match:
        raise ValueError(f"{path}: no frontmatter")
    fields = {}
    for line in match.group(1).split("\n"):
        key, _, value = line.partition(":")
        fields[key.strip()] = value.strip()
    return fields


def git_blob_sha(data):
    return hashlib.sha1(b"blob %d\0" % len(data) + data).hexdigest()


def provenance_rows(root):
    rows = []
    for line in (Path(root) / "PROVENANCE.md").read_text(encoding="utf-8").split("\n"):
        cells = [cell.strip() for cell in line.strip().strip("|").split("|")]
        if len(cells) == 6 and cells[0].startswith("`"):
            rows.append(tuple(cell.strip("`") for cell in cells[:5]))
    return rows


def plugin_markdown(root):
    root = Path(root)
    return [path for path in sorted(root.rglob("*.md"))
            if path.relative_to(root).parts[0] not in (".git", "tests")]


def check_manifests(root):
    errors = []
    loaded = {}
    for name in MANIFESTS:
        try:
            loaded[name] = load_json(root / name)
        except (OSError, ValueError) as error:
            errors.append(f"manifest: {name}: {error}")
    for key in ("name", "version"):
        values = {name: data.get(key) for name, data in loaded.items()}
        if any(not isinstance(value, str) or not value for value in values.values()):
            errors.append(f"manifest: {key} must be a non-empty string in every manifest: {values}")
        elif len(set(values.values())) != 1:
            errors.append(f"manifest: {key} differs between manifests: {values}")
    names = {data.get("name") for data in loaded.values()}
    for name in MARKETPLACES:
        try:
            catalog = load_json(root / name)
        except (OSError, ValueError) as error:
            errors.append(f"manifest: {name}: {error}")
            continue
        if catalog.get("name") != "agentic-harness":
            errors.append(f"manifest: {name} must declare the agentic-harness marketplace")
        listed = {entry.get("name") for entry in catalog.get("plugins", []) if isinstance(entry, dict)}
        if not listed or not listed <= names:
            errors.append(f"manifest: {name} lists {sorted(listed, key=str)}, expected {sorted(names, key=str)}")
    return errors


def check_provenance(root):
    errors = []
    rows = provenance_rows(root)
    listed = {row[2] for row in rows}
    if len(listed) != len(rows):
        errors.append("provenance: duplicate destination")
    for _source, blob, destination, digest, klass in rows:
        if klass not in CLASSES:
            errors.append(f"provenance: {destination}: unknown class {klass}")
        if not re.fullmatch(r"[0-9a-f]{40}", blob):
            errors.append(f"provenance: {destination}: malformed source blob")
        try:
            data = (root / destination).read_bytes()
        except OSError:
            errors.append(f"provenance: {destination}: listed but missing")
            continue
        if hashlib.sha256(data).hexdigest() != digest:
            errors.append(f"provenance: {destination}: sha256 differs from PROVENANCE.md")
        if klass == "copy" and git_blob_sha(data) != blob:
            errors.append(f"provenance: {destination}: class copy but blob differs from the source")
    for directory in ASSET_DIRS:
        for path in sorted((root / directory).rglob("*")):
            relative = path.relative_to(root).as_posix()
            if path.is_file() and relative != "skills/verify-project/SKILL.md" and relative not in listed:
                errors.append(f"provenance: {relative} is not in PROVENANCE.md")
    return errors


def check_hook(root):
    codex_usage = {"type": "command", "command": 'python3 "${PLUGIN_ROOT}/scripts/auto-agent-usage"', "timeout": 3}
    configs = {
        "hooks/hooks.json": {
            "SessionStart": {"type": "command", "command": 'python3 "${CLAUDE_PLUGIN_ROOT}/hooks/session-start.py" --claude'},
        },
        "hooks/codex.json": {
            "SessionStart": {"type": "command", "command": 'python3 "${PLUGIN_ROOT}/hooks/session-start.py"'},
            "Stop": codex_usage,
            "SubagentStop": codex_usage,
            "SessionEnd": codex_usage,
        },
    }
    errors = []
    if (root / "plugin.json").exists():
        errors.append("hook: portable plugin.json takes precedence and suppresses native hooks in Codex 0.172.0")
    for name, expected in configs.items():
        try:
            config = load_json(root / name)
            if list(config) != ["hooks"] or list(config["hooks"]) != list(expected):
                errors.append(f"hook: unexpected hook configuration in {name}")
                continue
            for event, expected_hook in expected.items():
                (group,) = config["hooks"][event]
                (hook,) = group["hooks"]
                if hook != expected_hook:
                    errors.append(f"hook: unexpected {event} configuration in {name}")
        except (OSError, ValueError, KeyError, TypeError) as error:
            errors.append(f"hook: {name}: {error}")
    try:
        manifest = load_json(root / ".codex-plugin/plugin.json")
        if manifest["hooks"] != "./hooks/codex.json":
            errors.append("hook: Codex manifest must select hooks/codex.json")
    except (OSError, ValueError, KeyError, TypeError) as error:
        errors.append(f"hook: Codex manifest: {error}")
    if not (root / "hooks/session-start.py").is_file():
        errors.append("hook: hooks/session-start.py is missing")
    printed = root / "skills/orchestrate/SKILL.md"
    if not printed.is_file():
        errors.append("hook: skills/orchestrate/SKILL.md is missing")
    elif printed.stat().st_size > HOOK_PRINT_BUDGET:
        errors.append(f"hook: orchestrate context is {printed.stat().st_size} bytes, budget {HOOK_PRINT_BUDGET}")
    return errors


def check_frontmatter(root):
    errors = []
    for path in sorted((root / "skills").glob("*/SKILL.md")):
        try:
            fields = frontmatter(path)
        except ValueError as error:
            errors.append(f"frontmatter: {error}")
            continue
        if fields.get("name") != path.parent.name:
            errors.append(f"frontmatter: {path.relative_to(root)}: name must be {path.parent.name}")
        if not fields.get("description"):
            errors.append(f"frontmatter: {path.relative_to(root)}: description missing")
    for path in sorted((root / "agents").glob("*.md")):
        relative = path.relative_to(root)
        try:
            fields = frontmatter(path)
        except ValueError as error:
            errors.append(f"frontmatter: {error}")
            continue
        if fields.get("name") != path.stem:
            errors.append(f"frontmatter: {relative}: name must be {path.stem}")
        if not fields.get("description"):
            errors.append(f"frontmatter: {relative}: description missing")
        if fields.get("model") != "inherit":
            errors.append(f"frontmatter: {relative}: model must be inherit")
        for forbidden in ("hooks", "permissionMode", "mcpServers"):
            if forbidden in fields:
                errors.append(f"frontmatter: {relative}: {forbidden} is not allowed in plugin agents")
        if f"${{CLAUDE_PLUGIN_ROOT}}/roles/{path.stem}.md" not in path.read_text(encoding="utf-8"):
            errors.append(f"frontmatter: {relative}: must read ${{CLAUDE_PLUGIN_ROOT}}/roles/{path.stem}.md")
        if not (root / "roles" / f"{path.stem}.md").is_file():
            errors.append(f"frontmatter: {relative}: roles/{path.stem}.md is missing")
    return errors


def check_links(root):
    errors = []
    for path in plugin_markdown(root):
        for number, line in prose_lines(path.read_text(encoding="utf-8")):
            for target in re.findall(r"\]\(([^)\s]+)\)", line):
                if re.match(r"^[a-z][a-z0-9+.-]*:", target):
                    continue
                name, _, anchor = target.partition("#")
                destination = path if not name else (path.parent / name).resolve()
                where = f"{path.relative_to(root)}:{number}: {target}"
                if not destination.is_relative_to(root):
                    errors.append(f"links: {where} leaves the plugin")
                elif not destination.exists():
                    errors.append(f"links: {where} does not exist")
                elif anchor and not (destination.is_file() and destination.suffix == ".md"
                                     and anchor in slugs(destination)):
                    errors.append(f"links: {where}: no such heading")
    return errors


def check_shims(root):
    errors = []
    for shim, tool in SHIMS.items():
        path = root / "bin" / shim
        if not path.is_file() or not path.stat().st_mode & 0o111:
            errors.append(f"shims: bin/{shim} must be an executable file")
        elif f"/../scripts/{tool}\"" not in path.read_text(encoding="utf-8"):
            errors.append(f"shims: bin/{shim} does not exec scripts/{tool}")
        if not (root / "scripts" / tool).is_file():
            errors.append(f"shims: scripts/{tool} is missing")
    return errors


def check_agent_catalogue(root):
    errors = []
    for name in CATALOGUE_DOCS:
        try:
            text = (root / name).read_text(encoding="utf-8")
        except OSError as error:
            errors.append(f"agent-catalogue: {name}: {error}")
            continue
        for agent in HARNESS_NAMES:
            if f"`{agent}`" not in text and f"`agent:{agent}`" not in text:
                errors.append(f"agent-catalogue: {name}: agent catalogue drift, missing {agent}")
    return errors


SECRET_PATTERNS = (
    ("private key", re.compile(r"-----BEGIN (?:[A-Z0-9 ]+ )?PRIVATE KEY-----")),
    ("GitHub token", re.compile(r"\b(?:gh[pousr]_[A-Za-z0-9_]{20,}|github_pat_[A-Za-z0-9_]{20,})\b")),
    ("API key", re.compile(r"\b(?:sk-[A-Za-z0-9_-]{20,}|AKIA[0-9A-Z]{16})\b")),
    ("Slack token", re.compile(r"\bxox[baprs]-[A-Za-z0-9-]{10,}\b")),
)
LOCAL_PATH_PATTERN = re.compile(r"(?:/Users/[A-Za-z0-9._-]+|/home/[A-Za-z0-9._-]+|[A-Za-z]:\\Users\\[A-Za-z0-9._-]+)")
REQUIRED_PHRASES = {
    "skills/orchestrate/SKILL.md": (
        "specs/project-rules.md",
        "STOP REQUESTED — NO AUTO-RESUME",
        "PASS / FAIL / UNRUN",
        "fall back to native inheritance",
    ),
    "skills/task/SKILL.md": ("specs/project-rules.md",),
    "skills/tweak/SKILL.md": ("specs/project-rules.md",),
    "skills/spec/SKILL.md": ("specs/project-rules.md",),
    "skills/dev/SKILL.md": ("specs/project-rules.md",),
    "skills/roadmap/SKILL.md": ("specs/project-rules.md",),
    "skills/work-issue/SKILL.md": ("specs/project-rules.md",),
    "skills/handoff/SKILL.md": ("specs/project-rules.md", "STOP REQUESTED — NO AUTO-RESUME"),
    "skills/relay/SKILL.md": ("specs/project-rules.md", "agentic-relay"),
    "methodology/dynamic-agents.md": ("validate-core --project", "fall back to native inheritance"),
    "roles/implementation.md": ("$dev", "$task"),
}


def plugin_text_files(root):
    root = Path(root)
    files = []
    for path in sorted(root.rglob("*")):
        if not path.is_file():
            continue
        parts = path.relative_to(root).parts
        if any(part in (".git", "__pycache__", "tests") for part in parts):
            continue
        files.append(path)
    return files


def check_secrets(root):
    errors = []
    for path in plugin_text_files(root):
        try:
            text = path.read_text(encoding="utf-8")
        except (OSError, UnicodeError):
            continue
        relative = path.relative_to(root).as_posix()
        for lineno, line in enumerate(text.splitlines(), 1):
            for label, pattern in SECRET_PATTERNS:
                if pattern.search(line):
                    errors.append(f"secrets: {relative}:{lineno}: potential {label} detected")
    return errors


def check_neutrality(root):
    errors = []
    for path in plugin_text_files(root):
        try:
            text = path.read_text(encoding="utf-8")
        except (OSError, UnicodeError):
            continue
        relative = path.relative_to(root).as_posix()
        for lineno, line in enumerate(text.splitlines(), 1):
            if LOCAL_PATH_PATTERN.search(line):
                errors.append(f"neutrality: {relative}:{lineno}: hardcoded local user path")
    return errors


def check_git_diff(root):
    if not (Path(root) / ".git").exists():
        return []
    errors = []
    for extra in ((), ("--cached",)):
        try:
            proc = subprocess.run(
                ["git", "-C", str(root), "diff", *extra, "--check"],
                capture_output=True, text=True, check=False,
            )
        except OSError:
            return []
        if proc.returncode != 0:
            for line in (proc.stdout or proc.stderr).splitlines():
                if line.strip():
                    errors.append(f"git-diff: {line.strip()}")
    return errors


def check_required_phrases(root):
    errors = []
    for relative, phrases in REQUIRED_PHRASES.items():
        path = Path(root) / relative
        try:
            text = path.read_text(encoding="utf-8")
        except OSError as error:
            errors.append(f"required-phrases: {relative}: {error}")
            continue
        for phrase in phrases:
            if phrase not in text:
                errors.append(f"required-phrases: {relative}: missing required phrase {phrase!r}")
    return errors


def validate_plugin(root=PLUGIN_ROOT):
    root = Path(root).resolve()
    errors = []
    for check in (check_manifests, check_provenance, check_hook, check_frontmatter, check_links, check_shims,
                  check_agent_catalogue, check_secrets, check_neutrality, check_git_diff, check_required_phrases):
        errors.extend(check(root))
    return errors


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--project", type=Path,
                        help="validate <PROJECT>/.agents/harnesses/*.json instead of the plugin")
    parser.add_argument("--harness-file", type=Path,
                        help="validate only one host or coordinator harness JSON file")
    parser.add_argument("--root", type=Path, default=PLUGIN_ROOT, help="plugin root (default: this plugin)")
    args = parser.parse_args(argv)
    if args.harness_file is not None:
        if args.project is None:
            print("Not validated: --harness-file requires --project", file=sys.stderr)
            return 2
        if not args.project.is_dir():
            print(f"Not validated: {args.project} is not a directory", file=sys.stderr)
            return 2
        project = args.project.resolve()
        target = args.harness_file if args.harness_file.is_absolute() else (project / args.harness_file)
        errors = check_harness_file(target, project)
        report = f"harness files checked: {target.name}"
    elif args.project is not None:
        if not args.project.is_dir():
            print(f"Not validated: {args.project} is not a directory", file=sys.stderr)
            return 2
        errors = check_project_harnesses(args.project)
        report = harness_report(args.project)
    else:
        errors = validate_plugin(args.root)
        report = f"plugin checked: {Path(args.root).resolve()}"
    for error in errors:
        print(error)
    print(report)
    print("validate-core: %s" % (f"{len(errors)} problem(s)" if errors else "OK"))
    return 1 if errors else 0


if __name__ == "__main__":
    sys.exit(main())
